    <string name="high_accuracy_disabled_message">High accuracy (precise) location is disabled. Please enable precise location in App Settings.</string>
    <string name="background_location_disabled_message">Background location permission is disabled. To allow features to run in the background, select \'Allow all the time\' in App Settings.</string>
