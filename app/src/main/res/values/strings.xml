    <!-- Location Permission Dialogs -->
    <string name="dialog_foreground_rationale_title">Location Access Needed</string>
    <string name="dialog_foreground_rationale_message">This app requires location access to discover nearby services and show your exact position on the map. Without this permission, location-based features cannot function.</string>
    <string name="btn_not_now">Not Now</string>

    <string name="dialog_high_accuracy_rationale_title">High Accuracy Required</string>
    <string name="dialog_high_accuracy_rationale_message">You have granted Approximate location. To provide accurate navigation, geofencing, and precise real-time tracking, high-accuracy (Precise) location is required. Please allow Precise location access for the best experience.</string>
    <string name="btn_enable_high_accuracy">Enable High Accuracy</string>
    <string name="btn_keep_approximate">Keep Approximate</string>

    <string name="dialog_background_rationale_title">Background Location &amp; High Accuracy Rationale</string>
    <string name="dialog_background_rationale_message">Why this app needs Background Location:\n\n• Real-Time Monitoring &amp; Alerts: The app continuously monitors location in the background to send critical proximity alerts and geofence events even when closed or not in use.\n• High Accuracy Requirement: Background tracking relies on precise coordinates to ensure geofences trigger accurately without false alarms.\n\nOn the next screen, please select \'Allow all the time\' (or enable Location in Settings) so the app can function seamlessly in the background.</string>
    <string name="btn_proceed_to_settings">Proceed to Settings / Prompt</string>
    <string name="btn_cancel">Cancel</string>

